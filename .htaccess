
# Hide .php extensions at the site root while leaving /blog untouched.

# Disable MultiViews to avoid content-negotiation conflicts.
<IfModule mod_negotiation.c>
	Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Keep the WordPress blog folder working as-is.
	RewriteRule ^blog(?:/|$) - [L]

	# Canonical redirect: /file.php -> /file
	RewriteCond %{THE_REQUEST} \s([^\s?]+)\.php[?\s] [NC]
	RewriteCond %1 !^/blog(?:/|$) [NC]
	RewriteRule ^ %1 [R=301,L]

	# Internally serve PHP when the extensionless path maps to an existing .php file.
	RewriteCond %{REQUEST_URI} !^/blog(?:/|$) [NC]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME}.php -f
	RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# Ensure the index files include index.php
DirectoryIndex index.php index.html

 